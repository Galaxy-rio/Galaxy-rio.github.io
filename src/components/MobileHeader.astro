---
import LanguageSwitch from "./LanguageSwitch.astro";
import MaterialSymbol from "./MaterialSymbol.astro";
import ThemeToggle from "./ThemeToggle.astro";
import type { Locale } from "./types";

interface Props {
  lang: Locale;
  avatarSrc: string;
  avatarAlt: string;
  siteName: string;
  homeHref: string;
  brandLabel: string;
  themeLabel: string;
  languageLabel: string;
  activePath: string;
}

const {
  lang,
  avatarSrc,
  avatarAlt,
  siteName,
  homeHref,
  brandLabel,
  themeLabel,
  languageLabel,
  activePath,
} = Astro.props;
const drawerId = `mobile-navigation-drawer-${lang}`;
const menuLabel = lang === "zh" ? "打开导航菜单" : "Open navigation menu";
---

<header class="mobile-topbar">
  <button
    class="mobile-drawer-trigger"
    type="button"
    aria-label={menuLabel}
    title={menuLabel}
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls={drawerId}
    data-mobile-drawer-trigger
  >
    <MaterialSymbol name="menu" class="mobile-drawer-trigger-icon" />
  </button>
  <a class="mobile-brand" href={homeHref} aria-label={brandLabel}>
    <span class="mobile-brand-avatar">
      <img src={avatarSrc} alt={avatarAlt} width="48" height="48" decoding="async" />
    </span>
    <strong>{siteName}</strong>
  </a>
  <div class="mobile-actions">
    <LanguageSwitch
      lang={lang}
      label={languageLabel}
      pathname={activePath}
      class="mobile-language-switch"
      compact
    />
    <ThemeToggle label={themeLabel} class="mobile-theme-toggle" />
  </div>
</header>
