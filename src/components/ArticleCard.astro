---
import type { ContentLanguage } from "./types";

interface Props {
  title: string;
  summary?: string;
  href: string;
  publishedAt?: string;
  publishedLabel?: string;
  contentLanguage?: ContentLanguage;
  featured?: boolean;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  summary,
  href,
  publishedAt,
  publishedLabel,
  contentLanguage,
  featured = false,
  image,
  imageAlt = "",
} = Astro.props;
---

<a
  class:list={["article-card", { featured, "has-cover": Boolean(image) }]}
  href={href}
  aria-label={title}
>
  {
    image && (
      <div class="article-card-visual">
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="article-card-content">
    <div class="article-card-meta">
      {
        publishedAt && (
          <time datetime={publishedAt}>{publishedLabel ?? publishedAt}</time>
        )
      }
      {
        contentLanguage && (
          <span
            class="content-language-badge"
            aria-label={contentLanguage.label}
          >
            <span lang={contentLanguage.code}>{contentLanguage.label}</span>
          </span>
        )
      }
    </div>

    <div class="article-card-copy" lang={contentLanguage?.code}>
      <h2>{title}</h2>
      {summary && <p>{summary}</p>}
    </div>
  </div>
</a>
