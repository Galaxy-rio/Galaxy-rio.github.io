---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  headingId?: string;
  class?: string;
}

const {
  title,
  description,
  eyebrow,
  headingId = "page-title",
  class: className = "page-header",
} = Astro.props;
---

<header class={className} aria-labelledby={headingId}>
  <div class="page-header-copy">
    {eyebrow && <p class="section-kicker">{eyebrow}</p>}
    <h1 id={headingId}>{title}</h1>
    {description && <p class="page-header-description">{description}</p>}
  </div>
  {Astro.slots.has("actions") && <div class="page-header-actions"><slot name="actions" /></div>}
</header>
