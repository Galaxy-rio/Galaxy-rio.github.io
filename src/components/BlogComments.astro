---
import twikooScript from "twikoo/dist/twikoo.min.js?url";
import "../styles/comments.css";
import MaterialSymbol from "./MaterialSymbol.astro";
import type { Locale } from "../i18n/config";

interface Props {
  lang: Locale;
  slug: string;
}

const { lang, slug } = Astro.props;
const endpoint = import.meta.env.PUBLIC_TWIKOO_ENV_ID?.trim()
  || "https://comments.galaxyrio.top";
// Keep one discussion across interface languages, domains and URL encodings.
const commentPath = `/blog/${slug.split("/").map(encodeURIComponent).join("/")}/`;
const text = {
  zh: {
    title: "评论",
    description: "分享你的想法，或留下一个问题。",
    placeholder: "写下你的想法…",
    refresh: "刷新评论",
    manage: "管理评论",
    close: "关闭评论管理",
    markdown: "Markdown 格式帮助",
    copy: "复制",
    copied: "已复制",
    copyError: "请手动复制",
    loading: "正在加载评论…",
    unavailable: "评论暂时无法加载，请稍后重试。",
    retry: "重新加载",
    javascript: "开启 JavaScript 后即可查看和发表留言。",
  },
  en: {
    title: "Comments",
    description: "Share a thought or leave a question.",
    placeholder: "What's on your mind?",
    refresh: "Refresh comments",
    manage: "Manage comments",
    close: "Close comment management",
    markdown: "Markdown formatting help",
    copy: "Copy",
    copied: "Copied",
    copyError: "Copy manually",
    loading: "Loading comments…",
    unavailable: "Comments could not be loaded. Please try again.",
    retry: "Try again",
    javascript: "Enable JavaScript to read and leave comments.",
  },
}[lang];
---

<section
  id="comments"
  class="blog-comments"
  aria-labelledby="comments-title"
  lang={lang}
  data-blog-comments
  data-endpoint={endpoint}
  data-comment-path={commentPath}
  data-comment-language={lang === "zh" ? "zh-CN" : "en"}
  data-comment-script={twikooScript}
  data-loading-message={text.loading}
  data-error-message={text.unavailable}
  data-comment-placeholder={text.placeholder}
  data-refresh-label={text.refresh}
  data-manage-label={text.manage}
  data-close-label={text.close}
  data-markdown-label={text.markdown}
  data-prismjs-copy={text.copy}
  data-prismjs-copy-success={text.copied}
  data-prismjs-copy-error={text.copyError}
  data-prismjs-copy-timeout="2500"
>
  <header class="blog-comments-header">
    <span class="blog-comments-mark" aria-hidden="true">
      <MaterialSymbol name="more_horiz" opticalSize={32} />
    </span>
    <div>
      <h2 id="comments-title">{text.title}</h2>
      <p>{text.description}</p>
    </div>
  </header>
  <div class="blog-comments-feedback" data-comments-feedback hidden>
    <p role="status" aria-live="polite" data-comments-status></p>
    <button type="button" class="button button-tonal blog-comments-retry" data-comments-retry hidden>
      {text.retry}
    </button>
  </div>
  <div class="blog-comments-widget" data-comments-widget>
    <div id="twikoo-comments" data-comments-mount></div>
  </div>
  <noscript><p class="blog-comments-noscript">{text.javascript}</p></noscript>
</section>

<script>
  interface TwikooClient {
    init(options: {
      envId: string;
      el: string;
      path: string;
      lang: string;
    }): Promise<unknown>;
  }

  const clientWindow = window as Window & { twikoo?: TwikooClient };
  let clientPromise: Promise<TwikooClient> | undefined;

  function loadClient(src: string): Promise<TwikooClient> {
    if (clientWindow.twikoo) return Promise.resolve(clientWindow.twikoo);
    if (clientPromise) return clientPromise;

    clientPromise = new Promise<TwikooClient>((resolve, reject) => {
      const script = document.createElement("script");
      const fail = () => {
        window.clearTimeout(timeout);
        script.remove();
        clientPromise = undefined;
        reject(new Error("Could not load the comment client."));
      };
      const timeout = window.setTimeout(fail, 15000);
      script.src = src;
      script.async = true;
      script.onload = () => {
        window.clearTimeout(timeout);
        if (clientWindow.twikoo) resolve(clientWindow.twikoo);
        else fail();
      };
      script.onerror = fail;
      document.head.append(script);
    });
    return clientPromise;
  }

  document.querySelectorAll<HTMLElement>("[data-blog-comments]").forEach((section) => {
    const feedback = section.querySelector<HTMLElement>("[data-comments-feedback]");
    const status = section.querySelector<HTMLElement>("[data-comments-status]");
    const retry = section.querySelector<HTMLButtonElement>("[data-comments-retry]");
    const mount = section.querySelector<HTMLElement>("[data-comments-mount]");
    const widget = section.querySelector<HTMLElement>("[data-comments-widget]");
    if (!feedback || !status || !retry || !mount || !widget) return;
    let state: "idle" | "loading" | "ready" | "error" = "idle";

    // Twikoo replaces its mount node and renders new forms when replying.
    // Keep labels and keyboard access attached to the rendered controls.
    const enhancedControls = new WeakSet<HTMLElement>();
    const enhanceControls = () => {
      widget.querySelectorAll<HTMLInputElement>(".tk-meta-input input, .tk-password input").forEach((input) => {
        const label = input.parentElement?.querySelector(".el-input-group__prepend")?.textContent?.trim();
        if (label) input.setAttribute("aria-label", label);
      });
      widget.querySelectorAll<HTMLTextAreaElement>(".tk-input textarea").forEach((input) => {
        input.setAttribute("aria-label", section.dataset.commentPlaceholder ?? "");
        if (!input.placeholder) input.placeholder = section.dataset.commentPlaceholder ?? "";
      });
      widget.querySelectorAll<HTMLElement>(".tk-comments-title .tk-icon.__comments").forEach((icon) => {
        // Vue keeps a comment in the refresh slot while comments are loading.
        const label = icon === icon.parentNode?.firstChild
          ? section.dataset.refreshLabel
          : section.dataset.manageLabel;
        if (!label) return;
        icon.setAttribute("role", "button");
        icon.setAttribute("aria-label", label);
        icon.title = label;
        icon.tabIndex = 0;
        if (enhancedControls.has(icon)) return;
        icon.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            icon.click();
          }
        });
        enhancedControls.add(icon);
      });
      widget.querySelectorAll<HTMLAnchorElement>(".tk-submit-action-icon.__markdown").forEach((link) => {
        link.setAttribute("aria-label", section.dataset.markdownLabel ?? "");
        link.title = section.dataset.markdownLabel ?? "";
      });
      widget.querySelectorAll<HTMLAnchorElement>(".tk-admin-close").forEach((link) => {
        link.setAttribute("aria-label", section.dataset.closeLabel ?? "");
      });
    };
    new MutationObserver(enhanceControls).observe(widget, { childList: true, subtree: true });

    const load = async () => {
      if (state === "loading" || state === "ready") return;
      state = "loading";
      feedback.hidden = false;
      status.textContent = section.dataset.loadingMessage ?? "";
      retry.hidden = true;
      widget.setAttribute("aria-busy", "true");
      try {
        const client = await loadClient(section.dataset.commentScript!);
        if (!mount.isConnected) widget.replaceChildren(mount);
        await client.init({
          envId: section.dataset.endpoint!,
          el: `#${mount.id}`,
          path: section.dataset.commentPath!,
          lang: section.dataset.commentLanguage!,
        });
        enhanceControls();
        state = "ready";
        feedback.hidden = true;
      } catch {
        state = "error";
        status.textContent = section.dataset.errorMessage ?? "";
        retry.hidden = false;
      } finally {
        widget.setAttribute("aria-busy", "false");
      }
    };

    retry.addEventListener("click", load);
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          void load();
        }
      }, { rootMargin: "400px" });
      observer.observe(section);
    } else {
      void load();
    }
  });
</script>
