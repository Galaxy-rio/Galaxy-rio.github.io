---
import LanguageSwitch from "./LanguageSwitch.astro";
import MaterialSymbol from "./MaterialSymbol.astro";
import ThemeToggle from "./ThemeToggle.astro";
import type { Locale, NavItem } from "./types";

interface Props {
  lang: Locale;
  items: NavItem[];
  activePath: string;
  navigationLabel: string;
  themeLabel: string;
  languageLabel: string;
}

const {
  lang,
  items,
  activePath,
  navigationLabel,
  themeLabel,
  languageLabel,
} = Astro.props;

const normalizePath = (path: string) => {
  const cleanPath = path.split(/[?#]/, 1)[0] || "/";
  return cleanPath === "/" ? cleanPath : cleanPath.replace(/\/+$/, "");
};

const currentPath = normalizePath(activePath);
const isActive = (item: NavItem) => {
  const itemPath = normalizePath(item.href);
  return item.exact
    ? currentPath === itemPath
    : currentPath === itemPath || currentPath.startsWith(`${itemPath}/`);
};

const findBySuffix = (suffix: string) =>
  items.find((item) => normalizePath(item.href).endsWith(suffix));

const preferredPrimary = [
  items.find((item) => item.exact) ?? items[0],
  findBySuffix("/projects"),
  findBySuffix("/research"),
  findBySuffix("/blog"),
].filter((item): item is NavItem => Boolean(item));

const primaryItems = Array.from(new Set(preferredPrimary));
for (const item of items) {
  if (primaryItems.length >= 4) break;
  if (!primaryItems.includes(item)) primaryItems.push(item);
}

const overflowItems = items.filter((item) => !primaryItems.includes(item));
const overflowActive = overflowItems.some(isActive);
const moreLabel = lang === "zh" ? "更多" : "More";
const moreTitle = lang === "zh" ? "更多页面" : "More pages";
const closeLabel = lang === "zh" ? "关闭更多页面" : "Close more pages";
const dialogId = `mobile-more-navigation-${lang}`;
const drawerId = `mobile-navigation-drawer-${lang}`;
const drawerCloseLabel = lang === "zh" ? "收起侧栏" : "Collapse navigation drawer";
---

<nav
  class="mobile-nav"
  aria-label={navigationLabel}
  data-mobile-nav
  data-mobile-more-target={dialogId}
>
  {
    primaryItems.map((item) => {
      const active = isActive(item);
      return (
        <a
          class:list={["mobile-nav-item", { active }]}
          href={item.href}
          aria-current={active ? "page" : undefined}
        >
          <span class="mobile-nav-indicator" aria-hidden="true">
            {item.icon && (
              <MaterialSymbol
                name={item.icon}
                filled={active}
                weight={active ? 600 : 400}
              />
            )}
          </span>
          <span class="mobile-nav-label">{item.label}</span>
        </a>
      );
    })
  }

  {
    overflowItems.length > 0 && (
      <button
        class:list={["mobile-nav-item", "mobile-more-trigger", { active: overflowActive }]}
        type="button"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls={dialogId}
        data-mobile-more-trigger
      >
        <span class="mobile-nav-indicator" aria-hidden="true">
          <MaterialSymbol name="more_horiz" filled={overflowActive} weight={overflowActive ? 600 : 400} />
        </span>
        <span class="mobile-nav-label">{moreLabel}</span>
      </button>
    )
  }
</nav>

{
  overflowItems.length > 0 && (
    <dialog
      id={dialogId}
      class="mobile-more-drawer"
      aria-labelledby={`${dialogId}-title`}
      data-mobile-more-dialog
    >
      <div class="mobile-more-drawer-content">
        <header class="mobile-more-drawer-header">
          <h2 id={`${dialogId}-title`}>{moreTitle}</h2>
          <button
            class="mobile-more-close"
            type="button"
            aria-label={closeLabel}
            title={closeLabel}
            data-mobile-more-close
          >
            <MaterialSymbol name="close" />
          </button>
        </header>

        <nav class="mobile-more-links" aria-label={moreTitle}>
          {overflowItems.map((item) => {
            const active = isActive(item);
            return (
              <a
                class:list={["mobile-more-link", { active }]}
                href={item.href}
                aria-current={active ? "page" : undefined}
                data-mobile-more-link
              >
                <span class="mobile-more-link-indicator" aria-hidden="true">
                  {item.icon && (
                    <MaterialSymbol
                      name={item.icon}
                      filled={active}
                      weight={active ? 600 : 400}
                    />
                  )}
                </span>
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>
      </div>
    </dialog>
  )
}

<dialog
  id={drawerId}
  class="mobile-navigation-drawer"
  aria-label={navigationLabel}
  data-mobile-navigation-drawer
>
  <div class="mobile-navigation-drawer-content">
    <header class="mobile-navigation-drawer-header">
      <button
        class="mobile-navigation-drawer-close"
        type="button"
        aria-label={drawerCloseLabel}
        title={drawerCloseLabel}
        data-mobile-drawer-close
      >
        <span class="mobile-navigation-drawer-collapse-icon" aria-hidden="true"></span>
      </button>
    </header>

    <nav class="mobile-navigation-drawer-links" aria-label={navigationLabel}>
      {
        items.map((item) => {
          const active = isActive(item);
          return (
            <a
              class:list={["mobile-navigation-drawer-link", { active }]}
              href={item.href}
              aria-current={active ? "page" : undefined}
              data-mobile-drawer-link
            >
              <span class="mobile-navigation-drawer-link-icon" aria-hidden="true">
                {item.icon && (
                  <MaterialSymbol
                    name={item.icon}
                    filled={active}
                    weight={active ? 600 : 400}
                  />
                )}
              </span>
              <span class="mobile-navigation-drawer-link-label">{item.label}</span>
            </a>
          );
        })
      }
    </nav>

    <div class="mobile-navigation-drawer-actions">
      <LanguageSwitch
        lang={lang}
        label={languageLabel}
        pathname={activePath}
        class="mobile-drawer-language-switch"
      />
      <ThemeToggle
        label={themeLabel}
        text={themeLabel}
        class="mobile-drawer-theme-toggle"
      />
    </div>
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>("[data-mobile-nav]").forEach((navigation) => {
    const dialogId = navigation.dataset.mobileMoreTarget;
    const trigger = navigation.querySelector<HTMLButtonElement>("[data-mobile-more-trigger]");
    const dialog = dialogId
      ? document.getElementById(dialogId) as HTMLDialogElement | null
      : null;

    if (!trigger || !dialog) return;

    const closeButton = dialog.querySelector<HTMLButtonElement>("[data-mobile-more-close]");

    const openDialog = () => {
      trigger.setAttribute("aria-expanded", "true");
      if (typeof dialog.showModal === "function") {
        dialog.showModal();
      } else {
        dialog.setAttribute("open", "");
      }
      requestAnimationFrame(() => closeButton?.focus());
    };

    const closeDialog = () => {
      if (typeof dialog.close === "function" && dialog.open) {
        dialog.close();
      } else {
        dialog.removeAttribute("open");
        trigger.setAttribute("aria-expanded", "false");
        trigger.focus();
      }
    };

    trigger.addEventListener("click", openDialog);
    closeButton?.addEventListener("click", closeDialog);

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeDialog();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      event.preventDefault();
      closeDialog();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      const inside =
        event.clientX >= bounds.left &&
        event.clientX <= bounds.right &&
        event.clientY >= bounds.top &&
        event.clientY <= bounds.bottom;
      if (!inside) closeDialog();
    });

    dialog.querySelectorAll<HTMLAnchorElement>("[data-mobile-more-link]").forEach((link) => {
      link.addEventListener("click", closeDialog);
    });

    dialog.addEventListener("close", () => {
      trigger.setAttribute("aria-expanded", "false");
      trigger.focus();
    });
  });

  document.querySelectorAll<HTMLDialogElement>("[data-mobile-navigation-drawer]").forEach((drawer) => {
    const triggers = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-mobile-drawer-trigger]"),
    ).filter((trigger) => trigger.getAttribute("aria-controls") === drawer.id);
    const closeButton = drawer.querySelector<HTMLButtonElement>("[data-mobile-drawer-close]");
    const activeLink = drawer.querySelector<HTMLAnchorElement>('[aria-current="page"]');
    const narrowScreen = window.matchMedia("(max-width: 599px)");
    let activeTrigger: HTMLButtonElement | null = null;

    if (triggers.length === 0) return;

    const updateTriggers = (expanded: boolean) => {
      triggers.forEach((trigger) => {
        trigger.setAttribute("aria-expanded", String(expanded));
      });
    };

    const openDrawer = (trigger: HTMLButtonElement) => {
      activeTrigger = trigger;
      updateTriggers(true);
      if (typeof drawer.showModal === "function") {
        drawer.showModal();
      } else {
        drawer.setAttribute("open", "");
      }
      requestAnimationFrame(() => (activeLink ?? closeButton)?.focus());
    };

    const closeDrawer = () => {
      if (typeof drawer.close === "function" && drawer.open) {
        drawer.close();
      } else {
        drawer.removeAttribute("open");
        updateTriggers(false);
        activeTrigger?.focus();
      }
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => openDrawer(trigger));
    });
    closeButton?.addEventListener("click", closeDrawer);

    drawer.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeDrawer();
    });

    drawer.addEventListener("click", (event) => {
      if (event.target !== drawer) return;
      const bounds = drawer.getBoundingClientRect();
      const inside =
        event.clientX >= bounds.left &&
        event.clientX <= bounds.right &&
        event.clientY >= bounds.top &&
        event.clientY <= bounds.bottom;
      if (!inside) closeDrawer();
    });

    drawer.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("click", closeDrawer);
    });

    drawer.addEventListener("close", () => {
      updateTriggers(false);
      activeTrigger?.focus();
      activeTrigger = null;
    });

    narrowScreen.addEventListener("change", (event) => {
      if (!event.matches && drawer.open) closeDrawer();
    });
  });
</script>
