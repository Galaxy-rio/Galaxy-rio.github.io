---
import { getCollection } from "astro:content";
import EmptyState from "../../../components/EmptyState.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import { contentCategoryLabels } from "../../../data/contentMeta";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  isLocale,
  localeLabels,
  locales,
  routeFor,
  t,
  type Locale,
} from "../../../i18n/config";
import {
  contentSlugFromId,
  selectLocalizedEntries,
} from "../../../utils/localizedContent";
import {
  compareContentDateTimeDescending,
  contentDateTime,
  contentDateTimeIso,
} from "../../../utils/contentDateTime";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Locale;
}

const { lang }: Props = Astro.props;

if (!isLocale(lang)) {
  throw new Error(`Unsupported locale: ${String(lang)}`);
}

const projects = selectLocalizedEntries(
  await getCollection("projects", ({ data }) => data.status === "publish"),
  lang,
).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    compareContentDateTimeDescending(a, b),
);

const copy = {
  zh: {
    title: "作品集",
    description: "收录软件、设计、手工、科研与学习实践。",
    emptyTitle: "项目整理中",
    emptyDescription: "项目内容正在整理中。",
    featured: "精选",
    series: "系列",
  },
  en: {
    title: "Portfolio",
    description: "Software, design, handcraft, research, and learning projects.",
    emptyTitle: "Projects coming soon",
    emptyDescription: "Project details will be added soon.",
    featured: "Featured",
    series: "Series",
  },
} as const;

const text = copy[lang];
const dateTimeFormatter = new Intl.DateTimeFormat(lang === "zh" ? "zh-CN" : "en", {
  dateStyle: "long",
  timeStyle: "short",
  timeZone: "Asia/Shanghai",
});
---

<BaseLayout
  lang={lang}
  title={text.title}
  description={text.description}
  activePath={Astro.url.pathname}
>
  <PageHeader
    title={text.title}
    description={text.description}
    eyebrow={t(lang, "section.portfolio.kicker")}
  />

  {
    projects.length > 0 ? (
      <section class="project-grid page-section" aria-label={text.title}>
        {projects.map((project, index) => (
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            href={routeFor(lang, `/projects/${contentSlugFromId(project.id)}/`)}
            number={String(index + 1).padStart(2, "0")}
            category={contentCategoryLabels[lang][project.data.category]}
            featuredLabel={project.data.featured ? text.featured : undefined}
            publishedAt={contentDateTimeIso(project.data)}
            publishedLabel={dateTimeFormatter.format(contentDateTime(project.data))}
            series={project.data.series ? `${text.series}: ${project.data.series}` : undefined}
            tags={project.data.tags}
            actionLabel={t(lang, "actions.viewProject")}
            contentLanguage={{
              code: project.data.language,
              label: localeLabels[project.data.language],
            }}
            accent={["violet", "orange", "blue", "green"][index % 4]}
          />
        ))}
      </section>
    ) : (
      <div class="page-section">
        <EmptyState
          title={text.emptyTitle}
          description={text.emptyDescription}
          icon="◇"
        />
      </div>
    )
  }
</BaseLayout>
