---
import { getCollection, render, type CollectionEntry } from "astro:content";
import MaterialSymbol from "../../../components/MaterialSymbol.astro";
import { contentCategoryLabels } from "../../../data/contentMeta";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  assetPath,
  localeLabels,
  locales,
  routeFor,
  type Locale,
} from "../../../i18n/config";
import {
  contentSlugFromId,
  selectLocalizedEntries,
} from "../../../utils/localizedContent";
import {
  contentDateTime,
  contentDateTimeIso,
} from "../../../utils/contentDateTime";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.status === "publish");

  return locales.flatMap((lang) =>
    selectLocalizedEntries(projects, lang).map((entry) => ({
      params: { lang, slug: contentSlugFromId(entry.id) },
      props: { lang, entry },
    })),
  );
}

interface Props {
  lang: Locale;
  entry: CollectionEntry<"projects">;
}

const { lang, entry }: Props = Astro.props;
const { Content } = await render(entry);

const copy = {
  zh: {
    back: "返回作品集",
    published: "发布于",
    author: "作者",
    category: "类别",
    series: "系列",
    links: "相关链接",
    tags: "标签",
  },
  en: {
    back: "Back to portfolio",
    published: "Published",
    author: "Author",
    category: "Category",
    series: "Series",
    links: "Related links",
    tags: "Tags",
  },
} as const;

const text = copy[lang];
const dateTimeFormatter = new Intl.DateTimeFormat(lang === "zh" ? "zh-CN" : "en", {
  dateStyle: "long",
  timeStyle: "short",
  timeZone: "Asia/Shanghai",
});
const publishedAt = contentDateTime(entry.data);
const publishedAtIso = contentDateTimeIso(entry.data);
const cover = entry.data.cover
  ? /^https?:\/\//i.test(entry.data.cover)
    ? entry.data.cover
    : assetPath(entry.data.cover.replace(/^\//, ""))
  : undefined;
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.summary}
  activePath={Astro.url.pathname}
>
  <article class="content-detail" lang={entry.data.language}>
    <header class="content-detail-header">
      <a class="back-link" href={routeFor(lang, "/projects/")} lang={lang}>
        <MaterialSymbol name="arrow_back" /> {text.back}
      </a>
      <div class="content-detail-meta" lang={lang}>
        <span>{text.author}: {entry.data.author}</span>
        <span>{text.category}: {contentCategoryLabels[lang][entry.data.category]}</span>
        <span>
          {text.published}: <time datetime={publishedAtIso}>
            {dateTimeFormatter.format(publishedAt)}
          </time>
        </span>
        {
          entry.data.series && <span>{text.series}: {entry.data.series}</span>
        }
        <span class="content-language-badge" lang={entry.data.language}>
          {localeLabels[entry.data.language]}
        </span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="content-detail-summary">{entry.data.summary}</p>
      {
        entry.data.tags.length > 0 && (
          <ul class="content-tags" aria-label={text.tags}>
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <figure class="content-cover">
          <img src={cover} alt="" loading="eager" decoding="async" />
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      entry.data.links.length > 0 && (
        <aside class="content-links" aria-labelledby="project-links-title" lang={lang}>
          <h2 id="project-links-title">{text.links}</h2>
          <ul>
            {entry.data.links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="external noopener noreferrer">
                  {link.label} <MaterialSymbol name="arrow_outward" />
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>
</BaseLayout>
