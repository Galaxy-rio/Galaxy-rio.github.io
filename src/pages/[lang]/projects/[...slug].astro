---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ContentEnhancements from "../../../components/ContentEnhancements.astro";
import ContentSideNav from "../../../components/ContentSideNav.astro";
import MaterialSymbol from "../../../components/MaterialSymbol.astro";
import { contentCategoryLabels } from "../../../data/contentMeta";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  locales,
  routeFor,
  type Locale,
} from "../../../i18n/config";
import {
  contentSlugFromId,
  selectLocalizedEntries,
} from "../../../utils/localizedContent";
import {
  contentDateTime,
  contentDateTimeIso,
} from "../../../utils/contentDateTime";
import { resolveContentCover } from "../../../utils/contentCover";
import { selectSecondLevelHeadings } from "../../../utils/contentNavigation";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.status === "publish");

  return locales.flatMap((lang) =>
    selectLocalizedEntries(projects, lang).map((entry) => ({
      params: { lang, slug: contentSlugFromId(entry.id) },
      props: { lang, entry },
    })),
  );
}

interface Props {
  lang: Locale;
  entry: CollectionEntry<"projects">;
}

const { lang, entry }: Props = Astro.props;
const { Content, headings } = await render(entry);
const sectionHeadings = selectSecondLevelHeadings(headings);

const copy = {
  zh: {
    back: "返回作品集",
    author: "作者",
    category: "类别",
    series: "系列",
    links: "相关链接",
    tags: "标签",
    details: "作品信息",
    onThisPage: "本页内容",
    navigationLabel: "作品目录",
    imageDialog: "图片预览",
    enlargeImage: "放大图片",
    closeImage: "关闭图片预览",
  },
  en: {
    back: "Back to portfolio",
    author: "Author",
    category: "Category",
    series: "Series",
    links: "Related links",
    tags: "Tags",
    details: "Project details",
    onThisPage: "On this page",
    navigationLabel: "Project contents",
    imageDialog: "Image preview",
    enlargeImage: "Enlarge image",
    closeImage: "Close image preview",
  },
} as const;

const text = copy[lang];
const dateFormatter = new Intl.DateTimeFormat(lang === "zh" ? "zh-CN" : "en", {
  dateStyle: "long",
  timeZone: "Asia/Shanghai",
});
const publishedAt = contentDateTime(entry.data);
const publishedAtIso = contentDateTimeIso(entry.data);
const cover = resolveContentCover(entry.data.cover);
const showSummary = entry.data.summary.trim() !== entry.data.title.trim();
const sideNavigationItems = sectionHeadings.map((heading) => ({
  label: heading.text,
  href: `#${heading.slug}`,
  targetId: heading.slug,
  language: entry.data.language,
}));
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.summary}
  activePath={Astro.url.pathname}
  mainClass="content-detail-page"
>
  <article
    class:list={["content-detail-layout", { "without-side-nav": sideNavigationItems.length === 0 }]}
    lang={entry.data.language}
  >
    <header id="article-start" class="content-detail-hero">
      <a
        class="back-link content-detail-back-link"
        href={routeFor(lang, "/projects/")}
        lang={lang}
      >
        <MaterialSymbol name="arrow_back" /> {text.back}
      </a>

      <div class:list={["content-detail-header", { "has-cover": Boolean(cover) }]}>
        <div class="content-detail-header-copy">
          <div class="content-detail-meta" lang={lang}>
            <time datetime={publishedAtIso}>{dateFormatter.format(publishedAt)}</time>
          </div>
          <h1>{entry.data.title}</h1>
          {showSummary && <p class="content-detail-summary">{entry.data.summary}</p>}
        </div>

        {
          cover && (
            <figure class="content-detail-cover">
              <img src={cover} alt="" loading="eager" decoding="async" />
            </figure>
          )
        }
      </div>
    </header>

    {
      sideNavigationItems.length > 0 && (
        <ContentSideNav
          eyebrow={text.onThisPage}
          title={entry.data.title}
          ariaLabel={text.navigationLabel}
          items={sideNavigationItems}
          contentLanguage={entry.data.language}
        />
      )
    }

    <div class="content-detail-main">
      <dl class="content-detail-byline" aria-label={text.details} lang={lang}>
        <div class="content-detail-byline-item">
          <dt>{text.author}</dt>
          <dd>{entry.data.author}</dd>
        </div>
        <div class="content-detail-byline-item">
          <dt>{text.category}</dt>
          <dd>{contentCategoryLabels[lang][entry.data.category]}</dd>
        </div>
        {
          entry.data.series && (
            <div class="content-detail-byline-item content-detail-byline-series">
              <dt>{text.series}</dt>
              <dd>{entry.data.series}</dd>
            </div>
          )
        }
      </dl>

      <div class="prose">
        <Content />
      </div>

      {
        entry.data.tags.length > 0 && (
          <footer class="content-detail-end-meta" lang={lang}>
            <p>{text.tags}</p>
            <ul class="content-tags" lang={entry.data.language}>
              {entry.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </footer>
        )
      }

      {
        entry.data.links.length > 0 && (
          <aside class="content-links" aria-labelledby="project-links-title" lang={lang}>
            <h2 id="project-links-title">{text.links}</h2>
            <ul>
              {entry.data.links.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="external noopener noreferrer">
                    {link.label} <MaterialSymbol name="arrow_outward" />
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </article>

  <ContentEnhancements
    dialogLabel={text.imageDialog}
    enlargeLabel={text.enlargeImage}
    closeLabel={text.closeImage}
  />
</BaseLayout>
