---
import { getCollection, render, type CollectionEntry } from "astro:content";
import MaterialSymbol from "../../../components/MaterialSymbol.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  assetPath,
  localeLabels,
  locales,
  routeFor,
  type Locale,
} from "../../../i18n/config";

const slugFromId = (id: string) => id.replace(/\.(md|mdx)$/i, "").replace(/\/index$/, "");

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);

  return projects.flatMap((entry) =>
    locales.map((lang) => ({
      params: { lang, slug: slugFromId(entry.id) },
      props: { lang, entry },
    })),
  );
}

interface Props {
  lang: Locale;
  entry: CollectionEntry<"projects">;
}

const { lang, entry }: Props = Astro.props;
const { Content } = await render(entry);

const copy = {
  zh: {
    back: "返回作品集",
    completed: "完成于",
    links: "项目链接",
    tags: "标签",
    kinds: {
      software: "软件项目",
      design: "设计项目",
      research: "科研项目",
      other: "其他项目",
    },
  },
  en: {
    back: "Back to portfolio",
    completed: "Completed",
    links: "Project links",
    tags: "Tags",
    kinds: {
      software: "Software project",
      design: "Design project",
      research: "Research project",
      other: "Other project",
    },
  },
} as const;

const text = copy[lang];
const dateFormatter = new Intl.DateTimeFormat(lang === "zh" ? "zh-CN" : "en", {
  year: "numeric",
  month: "long",
});
const cover = entry.data.cover
  ? /^https?:\/\//i.test(entry.data.cover)
    ? entry.data.cover
    : assetPath(entry.data.cover.replace(/^\//, ""))
  : undefined;
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.summary}
  activePath={Astro.url.pathname}
>
  <article class="content-detail" lang={entry.data.language}>
    <header class="content-detail-header">
      <a class="back-link" href={routeFor(lang, "/projects/")} lang={lang}>
        <MaterialSymbol name="arrow_back" /> {text.back}
      </a>
      <div class="content-detail-meta" lang={lang}>
        <span>{text.kinds[entry.data.kind]}</span>
        <span class="content-language-badge" lang={entry.data.language}>
          {localeLabels[entry.data.language]}
        </span>
        {
          entry.data.completedAt && (
            <span>
              {text.completed}: <time datetime={entry.data.completedAt.toISOString()}>
                {dateFormatter.format(entry.data.completedAt)}
              </time>
            </span>
          )
        }
      </div>
      <h1>{entry.data.title}</h1>
      <p class="content-detail-summary">{entry.data.summary}</p>
      {
        entry.data.tags.length > 0 && (
          <ul class="content-tags" aria-label={text.tags}>
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <figure class="content-cover">
          <img src={cover} alt="" loading="eager" decoding="async" />
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      entry.data.links.length > 0 && (
        <aside class="content-links" aria-labelledby="project-links-title" lang={lang}>
          <h2 id="project-links-title">{text.links}</h2>
          <ul>
            {entry.data.links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="external noopener noreferrer">
                  {link.label} <MaterialSymbol name="arrow_outward" />
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>
</BaseLayout>
