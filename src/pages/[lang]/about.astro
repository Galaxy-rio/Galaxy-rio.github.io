---
import EmptyState from "../../components/EmptyState.astro";
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../data/profile";
import { assetPath, isLocale, locales, t, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Locale;
}

const { lang }: Props = Astro.props;

if (!isLocale(lang)) {
  throw new Error(`Unsupported locale: ${String(lang)}`);
}

const copy = {
  zh: {
    title: "关于我",
    description: "个人简介、教育背景与实践经历。",
    identity: "基本信息",
    handle: "昵称",
    name: "姓名",
    email: "邮箱",
    resumeTitle: "教育与经历",
    resumeDescription: "相关内容正在整理中。",
  },
  en: {
    title: "About",
    description: "A brief introduction, education, and experience.",
    identity: "Profile",
    handle: "Handle",
    name: "Name",
    email: "Email",
    resumeTitle: "Education & Experience",
    resumeDescription: "More details will be added soon.",
  },
} as const;

const text = copy[lang];
const hasPublicEmail = profile.email.includes("@");
---

<BaseLayout
  lang={lang}
  title={text.title}
  description={text.description}
  activePath={Astro.url.pathname}
>
  <PageHeader
    title={text.title}
    description={text.description}
    eyebrow={t(lang, "section.resume.kicker")}
  />

  <section class="profile-summary page-section" aria-labelledby="identity-title">
    <figure class="profile-summary-avatar">
      <img
        src={assetPath(profile.avatar.src)}
        alt={profile.avatar.alt[lang]}
        width="480"
        height="480"
        loading="eager"
        decoding="async"
      />
    </figure>

    <div class="profile-summary-copy">
      <h2 id="identity-title">{text.identity}</h2>
      <dl class="fact-list">
        <div>
          <dt>{text.handle}</dt>
          <dd>{profile.handle}</dd>
        </div>
        <div>
          <dt>{text.name}</dt>
          <dd>{profile.fullName}</dd>
        </div>
        {
          hasPublicEmail && (
            <div>
              <dt>{text.email}</dt>
              <dd>{profile.email}</dd>
            </div>
          )
        }
      </dl>
    </div>
  </section>

  <div class="page-section">
    <EmptyState
      title={text.resumeTitle}
      description={text.resumeDescription}
      icon="⌁"
    />
  </div>
</BaseLayout>
