---
import { getCollection } from "astro:content";
import ArticleCard from "../../../components/ArticleCard.astro";
import EmptyState from "../../../components/EmptyState.astro";
import PageHeader from "../../../components/PageHeader.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  isLocale,
  localeLabels,
  locales,
  routeFor,
  t,
  type Locale,
} from "../../../i18n/config";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Locale;
}

const { lang }: Props = Astro.props;

if (!isLocale(lang)) {
  throw new Error(`Unsupported locale: ${String(lang)}`);
}

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const copy = {
  zh: {
    title: "博客",
    description: "记录学习过程、技术实践和偶尔做的小玩意。",
    emptyTitle: "文章整理中",
    emptyDescription: "新文章会陆续更新。",
  },
  en: {
    title: "Blog",
    description: "Notes on learning, technical experiments, and occasional side projects.",
    emptyTitle: "Posts coming soon",
    emptyDescription: "New posts will appear here.",
  },
} as const;

const text = copy[lang];
const slugFromId = (id: string) => id.replace(/\.(md|mdx)$/i, "").replace(/\/index$/, "");
const dateFormatter = new Intl.DateTimeFormat(lang === "zh" ? "zh-CN" : "en", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  lang={lang}
  title={text.title}
  description={text.description}
  activePath={Astro.url.pathname}
>
  <PageHeader
    title={text.title}
    description={text.description}
    eyebrow={t(lang, "section.blog.kicker")}
  />

  {
    posts.length > 0 ? (
      <section class="article-list page-section" aria-label={text.title}>
        {posts.map((post, index) => (
          <ArticleCard
            title={post.data.title}
            summary={post.data.summary}
            href={routeFor(lang, `/blog/${slugFromId(post.id)}/`)}
            actionLabel={t(lang, "actions.readMore")}
            publishedAt={post.data.publishedAt.toISOString()}
            publishedLabel={dateFormatter.format(post.data.publishedAt)}
            tags={post.data.tags}
            contentLanguage={{
              code: post.data.language,
              label: localeLabels[post.data.language],
            }}
            featured={index === 0}
          />
        ))}
      </section>
    ) : (
      <div class="page-section">
        <EmptyState
          title={text.emptyTitle}
          description={text.emptyDescription}
          icon="✎"
        />
      </div>
    )
  }
</BaseLayout>
