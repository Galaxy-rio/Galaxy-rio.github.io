---
import { getCollection } from "astro:content";
import ArticleCard from "../../../components/ArticleCard.astro";
import ContentSideNav from "../../../components/ContentSideNav.astro";
import EmptyState from "../../../components/EmptyState.astro";
import PageHeader from "../../../components/PageHeader.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  isLocale,
  localeLabels,
  locales,
  routeFor,
  t,
  type Locale,
} from "../../../i18n/config";
import {
  contentSlugFromId,
  selectLocalizedEntries,
} from "../../../utils/localizedContent";
import {
  compareContentDateTimeDescending,
  contentDateTime,
  contentDateTimeIso,
} from "../../../utils/contentDateTime";
import { resolveContentCover } from "../../../utils/contentCover";
import { groupContentByYear } from "../../../utils/contentNavigation";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Locale;
}

const { lang }: Props = Astro.props;

if (!isLocale(lang)) {
  throw new Error(`Unsupported locale: ${String(lang)}`);
}

const posts = selectLocalizedEntries(
  await getCollection("blog", ({ data }) => data.status === "publish"),
  lang,
).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    compareContentDateTimeDescending(a, b),
);
const postGroups = groupContentByYear(posts);

const copy = {
  zh: {
    title: "博客",
    description: "记录学习过程、技术实践和偶尔做的小玩意。",
    emptyTitle: "文章整理中",
    emptyDescription: "新文章会陆续更新。",
    onThisPage: "本页内容",
    navigationLabel: "博客年份目录",
    all: "全部文章",
  },
  en: {
    title: "Blog",
    description: "Notes on learning, technical experiments, and occasional side projects.",
    emptyTitle: "Posts coming soon",
    emptyDescription: "New posts will appear here.",
    onThisPage: "On this page",
    navigationLabel: "Blog archive by year",
    all: "All posts",
  },
} as const;

const text = copy[lang];
const dateFormatter = new Intl.DateTimeFormat(lang === "zh" ? "zh-CN" : "en", {
  dateStyle: "long",
  timeZone: "Asia/Shanghai",
});
const sideNavigationItems = [
  {
    label: text.all,
    href: "#blog-page-title",
    targetId: "blog-page-title",
  },
  ...postGroups.map(({ year }) => ({
    label: year,
    href: `#blog-year-${year}`,
    targetId: `blog-year-${year}`,
  })),
];
---

<BaseLayout
  lang={lang}
  title={text.title}
  description={text.description}
  activePath={Astro.url.pathname}
>
  <div class:list={["content-index-layout", { "without-side-nav": posts.length === 0 }]}>
    <PageHeader
      title={text.title}
      description={text.description}
      eyebrow={t(lang, "section.blog.kicker")}
      headingId="blog-page-title"
    />

    {
      posts.length > 0 && (
        <ContentSideNav
          eyebrow={text.onThisPage}
          title={text.title}
          ariaLabel={text.navigationLabel}
          items={sideNavigationItems}
          contentLanguage={lang}
        />
      )
    }

    <div class="content-index-main">
      {
        posts.length > 0 ? (
          <div class="content-year-groups page-section" aria-label={text.all}>
            {postGroups.map(({ year, entries }) => (
              <section class="content-year-section" aria-labelledby={`blog-year-${year}`}>
                <p class="content-year-heading" id={`blog-year-${year}`}>{year}</p>
                <div class="article-list">
                  {entries.map((post) => (
                    <ArticleCard
                      title={post.data.title}
                      summary={post.data.summary}
                      href={routeFor(lang, `/blog/${contentSlugFromId(post.id)}/`)}
                      publishedAt={contentDateTimeIso(post.data)}
                      publishedLabel={dateFormatter.format(contentDateTime(post.data))}
                      contentLanguage={{
                        code: post.data.language,
                        label: localeLabels[post.data.language],
                      }}
                      featured={post.data.featured}
                      image={resolveContentCover(post.data.cover)}
                      imageAlt=""
                    />
                  ))}
                </div>
              </section>
            ))}
          </div>
        ) : (
          <div class="page-section">
            <EmptyState
              title={text.emptyTitle}
              description={text.emptyDescription}
              icon="✎"
            />
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
