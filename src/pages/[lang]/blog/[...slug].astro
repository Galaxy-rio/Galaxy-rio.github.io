---
import { getCollection, render, type CollectionEntry } from "astro:content";
import MaterialSymbol from "../../../components/MaterialSymbol.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  assetPath,
  localeLabels,
  locales,
  routeFor,
  type Locale,
} from "../../../i18n/config";

const slugFromId = (id: string) => id.replace(/\.(md|mdx)$/i, "").replace(/\/index$/, "");

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.flatMap((entry) =>
    locales.map((lang) => ({
      params: { lang, slug: slugFromId(entry.id) },
      props: { lang, entry },
    })),
  );
}

interface Props {
  lang: Locale;
  entry: CollectionEntry<"blog">;
}

const { lang, entry }: Props = Astro.props;
const { Content } = await render(entry);

const copy = {
  zh: {
    back: "返回博客",
    published: "发布于",
    updated: "更新于",
    tags: "标签",
  },
  en: {
    back: "Back to blog",
    published: "Published",
    updated: "Updated",
    tags: "Tags",
  },
} as const;

const text = copy[lang];
const dateFormatter = new Intl.DateTimeFormat(lang === "zh" ? "zh-CN" : "en", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const cover = entry.data.cover
  ? /^https?:\/\//i.test(entry.data.cover)
    ? entry.data.cover
    : assetPath(entry.data.cover.replace(/^\//, ""))
  : undefined;
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.summary}
  activePath={Astro.url.pathname}
>
  <article class="content-detail" lang={entry.data.language}>
    <header class="content-detail-header">
      <a class="back-link" href={routeFor(lang, "/blog/")} lang={lang}>
        <MaterialSymbol name="arrow_back" /> {text.back}
      </a>
      <div class="content-detail-meta" lang={lang}>
        <span>
          {text.published}: <time datetime={entry.data.publishedAt.toISOString()}>
            {dateFormatter.format(entry.data.publishedAt)}
          </time>
        </span>
        {
          entry.data.updatedAt && (
            <span>
              {text.updated}: <time datetime={entry.data.updatedAt.toISOString()}>
                {dateFormatter.format(entry.data.updatedAt)}
              </time>
            </span>
          )
        }
        <span class="content-language-badge" lang={entry.data.language}>
          {localeLabels[entry.data.language]}
        </span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="content-detail-summary">{entry.data.summary}</p>
      {
        entry.data.tags.length > 0 && (
          <ul class="content-tags" aria-label={text.tags}>
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <figure class="content-cover">
          <img src={cover} alt="" loading="eager" decoding="async" />
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
