---
import "../styles/global.css";

import {
  defaultLocale,
  localeLabels,
  locales,
  routeFor,
  t,
} from "../i18n/config";

const destinations = Object.fromEntries(
  locales.map((locale) => [locale, routeFor(locale)]),
);
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t(defaultLocale, "meta.description")} />
    <meta name="robots" content="noindex, follow" />
    <title>{t(defaultLocale, "meta.siteName")}</title>
    <script is:inline define:vars={{ destinations }}>
      (() => {
        let preferred = "";
        try {
          preferred = localStorage.getItem("portfolio-locale") || "";
        } catch {
          // Language detection still works when storage is unavailable.
        }

        const locale = preferred in destinations
          ? preferred
          : navigator.language.toLowerCase().startsWith("zh")
            ? "zh"
            : "en";

        window.location.replace(destinations[locale]);
      })();
    </script>
    <style>
      :root {
        color-scheme: light dark;
        background: var(--md-sys-color-surface);
        color: var(--md-sys-color-on-surface);
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        box-sizing: border-box;
        background: inherit;
        color: inherit;
      }

      main {
        width: min(100%, 34rem);
        padding: clamp(2rem, 7vw, 4rem);
        border-radius: var(--md-sys-shape-corner-extra-extra-large);
        background: var(--md-sys-color-primary-container);
        color: var(--md-sys-color-on-primary-container);
        text-align: center;
      }

      h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2.25rem, 9vw, var(--md-sys-typescale-display-large-size));
        font-weight: 650;
        line-height: 1.08;
      }

      p {
        margin: 0 0 2rem;
        color: color-mix(in srgb, currentColor 76%, transparent);
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
      }

      a {
        min-width: 7rem;
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 1.5rem;
        border-radius: var(--md-sys-shape-corner-full);
        background: var(--md-sys-color-primary);
        color: var(--md-sys-color-on-primary);
        font-size: var(--md-sys-typescale-label-large-size);
        font-weight: 650;
        text-decoration: none;
      }

      a:focus-visible {
        outline: 0.2rem solid var(--md-sys-color-on-primary-container);
        outline-offset: 0.2rem;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          background: #120b1a;
          color: #f1dfff;
        }

        main {
          background: #c7b4f5;
          color: #403168;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>galaxyrio</h1>
      <p>选择语言 · Choose a language</p>
      <nav aria-label="Language / 语言">
        {
          locales.map((locale) => (
            <a href={destinations[locale]} lang={locale}>{localeLabels[locale]}</a>
          ))
        }
      </nav>
    </main>
  </body>
</html>
